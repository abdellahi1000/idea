SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SECRET_KEY=

# AI face-verification provider (see admin/app/services/ai/). Defaults to
# "luxand" if unset - only needs to be set to switch providers.
AI_FACE_PROVIDER=luxand
LUXAND_API_TOKEN=

# Only used by scripts/apply_migrations.py (one-off deployment utility),
# never read by the Flask app itself. Get these from Supabase Dashboard ->
# Connect -> Session pooler.
SUPABASE_DB_HOST=
SUPABASE_DB_PORT=5432
SUPABASE_DB_NAME=postgres
SUPABASE_DB_USER=
SUPABASE_DB_PASSWORD=
